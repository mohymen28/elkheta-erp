// Prisma Schema - Elkheta ERP System
// Production-Ready: Full support for SQLite (Local) & PostgreSQL (Cloud / Supabase / Neon)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// =============================================
// CORE TABLES (Branches, Departments, Users)
// =============================================

model Branch {
  id          String   @id @default(cuid())
  nameAr      String   // اسم الفرع بالعربي
  nameEn      String?  // اسم الفرع بالانجليزي
  code        String   @unique // كود الفرع
  address     String?
  phone       String?
  managerName String?  // اسم مدير الفرع
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users             User[]
  departments       Department[]
  requisitions      Requisition[]
  stocks            Stock[]
  transfersFrom     StockTransfer[]    @relation("TransferFrom")
  transfersTo       StockTransfer[]    @relation("TransferTo")
  purchaseOrders    PurchaseOrder[]
  maintenanceOrders MaintenanceOrder[]

  @@map("branches")
}

model Department {
  id        String   @id @default(cuid())
  nameAr    String
  nameEn    String?
  code      String?
  branchId  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch       Branch        @relation(fields: [branchId], references: [id])
  users        User[]
  requisitions Requisition[]

  @@map("departments")
}

model User {
  id           String    @id @default(cuid())
  employeeId   String    @unique // رقم الموظف
  nameAr       String    // الاسم بالعربي
  nameEn       String?   // الاسم بالانجليزي
  email        String    @unique
  password     String    // hashed
  role         String    @default("EMPLOYEE") // SUPER_ADMIN, PURCHASE_MANAGER, BRANCH_MANAGER, DEPARTMENT_HEAD, WAREHOUSE_KEEPER, ACCOUNTANT, EMPLOYEE
  branchId     String?
  departmentId String?
  phone        String?
  avatar       String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  branch     Branch?     @relation(fields: [branchId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  requisitionsCreated      Requisition[]      @relation("RequisitionCreator")
  approvalLogs             ApprovalLog[]
  approvalStepsAsApprover  ApprovalStep[]     @relation("ApproverUser")
  purchaseOrdersCreated    PurchaseOrder[]    @relation("POCreator")
  transfersCreated         StockTransfer[]    @relation("TransferCreator")
  maintenanceOrdersCreated MaintenanceOrder[] @relation("MaintCreator")

  @@map("users")
}

// =============================================
// PRODUCT CATALOG
// =============================================

model Category {
  id        String     @id @default(cuid())
  nameAr    String
  nameEn    String?
  parentId  String?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children Category[] @relation("CategoryParent")
  products Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(cuid())
  nameAr      String
  nameEn      String?
  code        String   @unique
  description String?
  unit        String   // وحدة القياس
  categoryId  String
  minStock    Float    @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category         Category            @relation(fields: [categoryId], references: [id])
  requisitionItems RequisitionItem[]
  stocks           Stock[]
  poItems          PurchaseOrderItem[]
  transferItems    StockTransferItem[]

  @@map("products")
}

// =============================================
// APPROVAL FLOW TEMPLATES
// =============================================

model ApprovalFlowTemplate {
  id          String   @id @default(cuid())
  name        String   // اسم المسار
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  steps        ApprovalStep[]
  requisitions Requisition[]

  @@map("approval_flow_templates")
}

model ApprovalStep {
  id           String  @id @default(cuid())
  flowId       String
  stepOrder    Int     // 1, 2, 3...
  stepNameAr   String  // اسم الخطوة
  approverRole String  // Role name
  approverId   String? // User ID
  isRequired   Boolean @default(true)

  flow     ApprovalFlowTemplate @relation(fields: [flowId], references: [id])
  approver User?               @relation("ApproverUser", fields: [approverId], references: [id])

  @@unique([flowId, stepOrder])
  @@map("approval_steps")
}

// =============================================
// REQUISITIONS
// =============================================

model Requisition {
  id              String   @id @default(cuid())
  requisitionNo   String   @unique
  title           String
  type            String   @default("PURCHASE") // PURCHASE, TRANSFER, SERVICE
  urgency         String   @default("MEDIUM")   // LOW, MEDIUM, HIGH
  status          String   @default("DRAFT")    // DRAFT, PENDING, APPROVED, REJECTED, CONVERTED_TO_PO, CONVERTED_TO_TRANSFER, CANCELLED
  notes           String?
  justification   String?
  requiredDate    DateTime?

  createdById     String
  branchId        String
  departmentId    String?
  flowTemplateId  String?
  currentStep     Int      @default(1)
  estimatedTotal  Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy    User                  @relation("RequisitionCreator", fields: [createdById], references: [id])
  branch       Branch                @relation(fields: [branchId], references: [id])
  department   Department?           @relation(fields: [departmentId], references: [id])
  flowTemplate ApprovalFlowTemplate? @relation(fields: [flowTemplateId], references: [id])

  items          RequisitionItem[]
  approvalLogs   ApprovalLog[]
  purchaseOrders PurchaseOrder[]

  @@map("requisitions")
}

model RequisitionItem {
  id             String  @id @default(cuid())
  requisitionId  String
  productId      String
  description    String?
  quantity       Float
  unit           String
  estimatedPrice Float?
  totalPrice     Float?
  notes          String?

  requisition Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id])

  @@map("requisition_items")
}

// =============================================
// APPROVAL LOGS (Audit Trail)
// =============================================

model ApprovalLog {
  id            String   @id @default(cuid())
  requisitionId String
  approverId    String
  stepOrder     Int
  stepNameAr    String
  action        String   // APPROVED, REJECTED, FORWARDED
  comments      String?
  actionAt      DateTime @default(now())

  requisition Requisition @relation(fields: [requisitionId], references: [id])
  approver    User        @relation(fields: [approverId], references: [id])

  @@map("approval_logs")
}

// =============================================
// VENDORS & PROCUREMENT (الموردين وأوامر الشراء)
// =============================================

model Vendor {
  id          String   @id @default(cuid())
  nameAr      String   // اسم الشركة الموردة بالعربي
  nameEn      String?  // اسم الشركة بالإنجليزي
  phone       String?
  email       String?
  address     String?
  taxNumber   String?  // الرقم الضريبي / السجل التجاري
  category    String   // مجال التوريد (مواد خام، قطع غيار، معدات...)
  rating      Float    @default(5.0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchaseOrders PurchaseOrder[]

  @@map("vendors")
}

model PurchaseOrder {
  id            String   @id @default(cuid())
  poNumber      String   @unique // PO-2026-0001
  requisitionId String?  // إذا كان منشأ من طلب احتياج
  vendorId      String
  branchId      String   // الفرع المستفيد
  createdById   String
  status        String   @default("DRAFT") // DRAFT, APPROVED, RECEIVED, CANCELLED
  totalAmount   Float    @default(0)
  matchVerified Boolean  @default(false) // 3-Way Matching verified
  notes         String?
  deliveryDate  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  requisition Requisition?        @relation(fields: [requisitionId], references: [id])
  vendor      Vendor             @relation(fields: [vendorId], references: [id])
  branch      Branch             @relation(fields: [branchId], references: [id])
  createdBy   User               @relation("POCreator", fields: [createdById], references: [id])
  items       PurchaseOrderItem[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id          String  @id @default(cuid())
  poId        String
  productId   String
  quantity    Float
  unitPrice   Float
  totalPrice  Float
  receivedQty Float   @default(0)

  po      PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id])

  @@map("purchase_order_items")
}

// =============================================
// INVENTORY & TRANSFERS (المخازن والتحويلات)
// =============================================

model Stock {
  id        String   @id @default(cuid())
  branchId  String   // المخزن / الفرع
  productId String   // الصنف
  quantity  Float    @default(0) // الرصيد الحالي
  minStock  Float    @default(0) // حد إعادة الطلب للفرع
  updatedAt DateTime @updatedAt

  branch  Branch  @relation(fields: [branchId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([branchId, productId])
  @@map("stocks")
}

model StockTransfer {
  id           String   @id @default(cuid())
  transferNo   String   @unique // TR-2026-0001
  fromBranchId String   // من مخزن
  toBranchId   String   // إلى مخزن
  createdById  String
  status       String   @default("PENDING") // PENDING, IN_TRANSIT, DELIVERED, CANCELLED
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  fromBranch Branch              @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranch   Branch              @relation("TransferTo", fields: [toBranchId], references: [id])
  createdBy  User                @relation("TransferCreator", fields: [createdById], references: [id])
  items      StockTransferItem[]

  @@map("stock_transfers")
}

model StockTransferItem {
  id         String @id @default(cuid())
  transferId String
  productId  String
  quantity   Float

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id])

  @@map("stock_transfer_items")
}

// =============================================
// MAINTENANCE (الصيانة والأصول)
// =============================================

model MaintenanceOrder {
  id               String   @id @default(cuid())
  orderNo          String   @unique // WO-2026-0001
  branchId         String
  createdById      String
  assetName        String   // اسم الأصل / المعدة
  type             String   @default("PREVENTIVE") // PREVENTIVE (وقائية), EMERGENCY (طارئة)
  priority         String   @default("MEDIUM")     // LOW, MEDIUM, HIGH
  description      String?  // وصف العطل / الصيانة
  technician       String?  // الفني / جهة التنفيذ
  sparePartsNeeded String?  // قطع الغيار المطلوبة
  cost             Float?   @default(0)
  status           String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, CANCELLED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  branch    Branch @relation(fields: [branchId], references: [id])
  createdBy User   @relation("MaintCreator", fields: [createdById], references: [id])

  @@map("maintenance_orders")
}

model MaintenanceContract {
  id              String    @id @default(cuid())
  contractNo      String    @unique // CNT-2026-001
  title           String    // عنوان العقد (صيانة التكييفات، صيانة أنظمة الحريق...)
  serviceProvider String    // الشركة مقدمة الخدمة
  scope           String?   // النطاق والشروط
  annualCost      Float     @default(0)
  startDate       DateTime?
  expiryDate      DateTime  // تاريخ التجديد والانتهاء
  status          String    @default("ACTIVE") // ACTIVE, EXPIRING_SOON, EXPIRED
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("maintenance_contracts")
}
